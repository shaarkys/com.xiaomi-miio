        {
          "id": "off",
          "title": {
            "en": "Off",
            "fr": "Désactivé"
          }
        },
        {
          "id": "left_grams",
          "title": {
            "en": "Left grams",
            "fr": "Grammes restants"
          }
        },
        {
          "id": "eaten_grams",
          "title": {
            "en": "Eaten grams",
            "fr": "Grammes consommés"
          }
        },
        {
          "id": "percentage",
          "title": {
            "en": "Percentage",
            "fr": "Pourcentage"
          }
        }
      ]
    },
    {
      "name": "device",
      "type": "device",
      "placeholder": {
        "en": "Select device",
        "fr": "Sélectionner un appareil"
      },
      "filter": "driver_id=petfeeder_mmgg_miot&capabilities=petfeeder_screen_display_mode"
    }
  ],
  "platforms": [
    "local"
