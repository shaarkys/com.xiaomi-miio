{
  "title": {
    "en": "Set screen display",
    "fr": "Régler l’affichage de l’écran"
  },
  "titleFormatted": {
    "en": "Set screen display to [[mode]]",
    "fr": "Régler l’affichage de l’écran sur [[mode]]"
